{
  "name": "imgcompress",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "mygo dev",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "tsc --noEmit && vite build",
    "build": "mygo build",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "build:mac": "mygo build -platform darwin/arm64,darwin/amd64",
    "build:windows": "mygo build -platform windows/amd64",
    "build:windows:portable": "mygo build -platform windows/amd64 -skip-installer",
    "build:mac:arm64": "mygo build -platform darwin/arm64",
    "build:mac:intel": "mygo build -platform darwin/amd64",
    "build:mac:universal": "mygo build -platform darwin/universal"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/webp": "1.5.0",
    "mygo-runtime": "0.9.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "svgo": "^4.1.0",
    "wasm-feature-detect": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "mygo-cli": "0.9.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
